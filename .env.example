# Bu dosyayı ".env.local" adıyla kopyalayın ve değerleri doldurun.
# Tüm değişkenler isteğe bağlıdır; boş bırakılırsa uygulama yedek modlarla çalışmaya devam eder.

# Google Gemini API anahtarı (chatbot için) — https://aistudio.google.com/apikey
# Tanımlı değilse chatbot kural tabanlı öneri moduna geçer.
GEMINI_API_KEY=
# Kullanılacak Gemini modeli (varsayılan: gemini-3.5-flash)
GEMINI_MODEL=

# Geoapify Places API anahtarı (önerilir) — https://myprojects.geoapify.com
# Ücretsiz plan günde 3000 istek içerir. Tanımlı değilse yalnızca herkese açık Overpass sunucuları kullanılır.
GEOAPIFY_API_KEY=

# İsteğe bağlı: öncelikli kullanılacak özel bir Overpass sunucusu
OVERPASS_URL=
